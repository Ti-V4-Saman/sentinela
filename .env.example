# Configurações de Conexão com o Servidor QuePasa
VITE_QUEPASA_SERVER_URL=https://apiwhatsapp.v4saman.com
VITE_QUEPASA_USER=ti.bh@v4company.com
VITE_USE_MOCK=false

# Configurações do Banco de Dados
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha
DB_NAME=sentinela

# Integrações por webhook em lote: chave para cifrar o secret HMAC em repouso (AES-256-GCM).
# 32 bytes em hex (64 chars) ou base64. Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATIONS_SECRET_KEY=

# Integrações por webhook em lote: liga o envio externo real. Default false (desligado); só a
# string exata 'true' liga. Com o gate desligado, nenhum POST externo ocorre (nada aparece como
# sucesso falso) e os lotes da janela ficam registrados como 'blocked'.
EXTERNAL_INTEGRATIONS_ENABLED=false

# Integrações por webhook em lote: quantos dias no passado o job ainda entrega automaticamente
# batches criados como 'blocked' (gate desligado) quando o gate é ligado. Default 7.
INTEGRATIONS_MAX_CATCHUP_DAYS=7
